rules_version = '2';

// Règles de sécurité Firestore pour « Notre Maison ».
// À copier dans la console Firebase : Firestore Database > Règles > Publier.
// Seuls les membres d'un foyer peuvent lire et écrire les données de ce foyer.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isMember(fid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // Profil personnel (nom, couleur, foyer) : uniquement soi-même.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      allow read: if isMember(fid);

      // Créer un foyer : on en est le seul membre au départ.
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];

      // Un membre peut tout modifier ; quelqu'un qui a le code d'invitation
      // peut seulement s'ajouter lui-même à la liste des membres.
      allow update: if isMember(fid) || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
      );

      // Agenda, messages, pense-bête, membres…
      match /{collection}/{docId} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
